{
  "schema_version": 1,
  "requirements": [
    {
      "id": "workspace",
      "requirement": "工作区可迁移，UI 与无界面 Agent 使用同一引擎",
      "suites": [
        "workspace",
        "protocols",
        "ui-workspace-api",
        "ui-structure-agent"
      ]
    },
    {
      "id": "planning",
      "requirement": "整体初稿与提示词方案、自动归档、区域 AI 偏好",
      "suites": [
        "ui-api",
        "ui-workbench-ui",
        "ui-prompt-archive",
        "ui-ai-style",
        "py-prompt-archive"
      ]
    },
    {
      "id": "preview",
      "requirement": "默认材质 3D，可选择图片，预览不改原稿",
      "suites": [
        "ui-default-preview",
        "ui-desktop-smoke",
        "ui-library-layout"
      ]
    },
    {
      "id": "tools",
      "requirement": "26 类共用建模工具与参数硬校验、手动入口启停",
      "suites": [
        "tools",
        "modelling",
        "protocols",
        "ui-control-availability"
      ]
    },
    {
      "id": "assets",
      "requirement": "构件读写、内置及外部 Agent 直接生成入库，保留手动导入",
      "suites": [
        "py-components",
        "py-structure-agent",
        "py-generated-assets",
        "ui-asset-workspace",
        "ui-structure-agent"
      ]
    },
    {
      "id": "asset-batches",
      "requirement": "构件 JSON、NBT、主模型批量导入读取及工作区清单",
      "suites": [
        "py-asset-batches",
        "ui-asset-batches",
        "workspace-library"
      ]
    },
    {
      "id": "transforms",
      "requirement": "复制、移动、旋转、镜像、吸附、阵列与 3D 手柄",
      "suites": [
        "ui-component-gizmo",
        "ui-transform-sliders",
        "ui-ai-placement",
        "ui-reusable",
        "py-reusable-recipes"
      ]
    },
    {
      "id": "effects",
      "requirement": "原生工具效果管理、32项初始效果自动入库、预生成前后样例、Agent 脚本接入与配方版本绑定",
      "suites": [
        "py-starter-effects",
        "py-effect-assets",
        "ui-tool-effects",
        "ui-control-availability",
        "ui-reusable",
        "py-reusable-recipes",
        "ui-effect-gallery"
      ]
    },
    {
      "id": "organization",
      "requirement": "建筑与效果分开，自定义菜单，语义用途取代数字标签，保留资产身份与几何",
      "suites": [
        "ui-project-menus",
        "ui-library-layout",
        "workspace-library",
        "py-effect-assets"
      ]
    },
    {
      "id": "projects",
      "requirement": "项目及版本筛选、状态、尝试修复归类、缩略图、自动加载与批量队列",
      "suites": [
        "ui-project-manager",
        "ui-project-recovery",
        "py-project-repair",
        "ui-project-batch",
        "py-project-batch",
        "performance"
      ]
    },
    {
      "id": "editing",
      "requirement": "命名步骤启停、重排、撤销重做、保存草稿和重启恢复",
      "suites": [
        "py-operation-history",
        "ui-operation-history",
        "ui-edit-session",
        "ui-edit-session-images",
        "protocols"
      ]
    },
    {
      "id": "comparison",
      "requirement": "版本差异、同镜头前后对比与退出恢复原编辑",
      "suites": [
        "py-model-difference",
        "ui-version-compare",
        "ui-agent-task-return"
      ]
    },
    {
      "id": "ai",
      "requirement": "减少重复操作与请求输入，局部 AI、保护冲突裁剪、选区自然语言编辑",
      "suites": [
        "ui-api",
        "ui-ai-placement",
        "ui-selection-edit",
        "py-selection-edit",
        "ui-protection",
        "py-protection-mask",
        "protocols"
      ]
    },
    {
      "id": "quality",
      "requirement": "通路、净空、支撑、风险及诊断定位，综合质量与可选外观量表",
      "suites": [
        "py-walk-inspection",
        "ui-walk",
        "py-diagnostic-guidance",
        "py-room-score",
        "ui-room-score"
      ]
    },
    {
      "id": "references",
      "requirement": "按已启用资料检索，保留出处并适配现有构件",
      "suites": [
        "py-retrieval",
        "ui-retrieval",
        "protocols"
      ]
    },
    {
      "id": "collaboration",
      "requirement": "评论整理和证据、任务回传、人工逐项核对与制作批次",
      "suites": [
        "py-feedback-tasks",
        "ui-feedback-tasks",
        "py-agent-task-return",
        "ui-agent-task-return",
        "py-batches",
        "ui-batch-workspaces"
      ]
    },
    {
      "id": "usability",
      "requirement": "项目与资产卡片简洁、宽度缩放适配、命令搜索快捷键和任务状态反馈",
      "suites": [
        "ui-library-layout",
        "ui-workbench-ui",
        "ui-commands",
        "ui-control-availability",
        "ui-asset-interaction",
        "performance"
      ]
    },
    {
      "id": "invariants",
      "requirement": "源哈希、保护预算、实际看图与明确导出分开、Host/Origin 和上下文隔离",
      "suites": [
        "py-candidate-validation",
        "refinement",
        "production",
        "ui-desktop-smoke",
        "ui-authoring-journey",
        "archive"
      ]
    },
    {
      "id": "delivery",
      "requirement": "显式导出下一版，NBT 与主模型回读一致，完整目录含私有运行环境",
      "suites": [
        "delivery",
        "ui-authoring-journey",
        "private-runtime"
      ]
    },
    {
      "id": "maintenance",
      "requirement": "工具清单、环境及 Skill 文档可检验，原 SAODG 与迁移参考不改动",
      "suites": [
        "doctor",
        "tools",
        "skill",
        "archive"
      ]
    }
  ],
